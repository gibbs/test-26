{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "dev": "vite",
        "types": "vue-tsc --noEmit",
        "test:e2e": "playwright test",
        "test": "vitest run",
        "format": "prettier --write resources/js tests/E2E \"*.config.ts\"",
        "format:check": "prettier --check resources/js tests/E2E \"*.config.ts\""
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "vue": "^3.5.44"
    }
}
